# ==============================================================================
#  Conecta — Mesa de Ayuda Dimak
# ==============================================================================
#
#  Plantilla de configuracion. Copiar como .env y completar los valores.
#
#  Los valores de abajo son los de PRODUCCION. Cada bloque indica que cambiar
#  para trabajar en un equipo de desarrollo.
#
#  El archivo .env nunca se sube al repositorio: contiene las credenciales.
#
# ==============================================================================

APP_NAME="Conecta Mesa de Ayuda"

# En desarrollo: APP_ENV=local y APP_DEBUG=true
#
# APP_DEBUG en true muestra, ante cualquier error, el rastro completo del
# codigo y las variables de entorno —incluidas las credenciales de la base de
# datos— a quien tenga la pantalla delante. En produccion va en false siempre.
APP_ENV=production
APP_DEBUG=false

# Generar con: php artisan key:generate
APP_KEY=

# Direccion real desde donde se accede. Con el valor equivocado, los enlaces de
# los correos apuntan a un sitio que no existe.
APP_URL=https://conecta.dimak.cl

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# En desarrollo: LOG_LEVEL=debug
# En produccion 'error' evita llenar el disco con detalle que nadie revisa.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ── Base de datos (MySQL) ──────────────────────────────────────────────────────
#
# Usar un usuario propio de la aplicacion con permisos solo sobre esta base.
# No usar 'root', y nunca sin contrasena.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=conecta
DB_USERNAME=
DB_PASSWORD=

# ── Sesion ────────────────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log

# Disco privado: los adjuntos, avatares e imagenes de articulos no quedan
# accesibles por URL. Se sirven por FileController, que valida la sesion.
FILESYSTEM_DISK=local

CACHE_STORE=database

# ── Cola de trabajos ──────────────────────────────────────────────────────────
#
# IMPORTANTE: las notificaciones se encolan. Si no hay un proceso consumiendo
# la cola, los correos se acumulan en la tabla 'jobs' y no salen nunca, sin
# ningun error visible. Ver "Requisitos del servidor" al final de este archivo.
QUEUE_CONNECTION=database

# ── Correo ────────────────────────────────────────────────────────────────────
#
# En desarrollo: MAIL_MAILER=log escribe los correos en el log en vez de
# enviarlos. En produccion eso significa que nadie recibe nada.
MAIL_MAILER=smtp
MAIL_HOST=mail.dimak.cl
MAIL_PORT=587
MAIL_SCHEME=null
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="soporte@dimak.cl"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ── Horario laboral para los plazos de SLA ────────────────────────────────────
#
# Los plazos se cuentan en horas de trabajo, no de reloj. Confirmar el horario
# real de la empresa: cambiarlo altera todos los plazos de los tickets nuevos.
SLA_HORARIO_LABORAL=true
SLA_HORA_INICIO=08:30
SLA_HORA_FIN=18:30

# ── Asistente de la base de conocimiento ──────────────────────────────────────
#
# Requiere un servidor con Ollama en la red interna. En false la plataforma
# funciona igual, solo sin el asistente: el centro de ayuda sigue entregando
# los articulos que corresponden.
#
# El modelo ocupa unos 5 GB de memoria mientras esta cargado.
CHATBOT_ENABLED=false
CHATBOT_URL=http://127.0.0.1:11434
CHATBOT_MODEL=qwen2.5:7b
CHATBOT_TIMEOUT=60
CHATBOT_KEEP_ALIVE=30m

# ==============================================================================
#  Requisitos del servidor
# ==============================================================================
#
#  Dos procesos tienen que quedar corriendo de forma permanente. Sin ellos la
#  plataforma se ve normal y deja de funcionar por dentro:
#
#  1. Consumidor de la cola — sin esto NO se envia ningun correo
#     php artisan queue:work --tries=3
#
#  2. Programador de tareas — sin esto no se cierran los tickets sin respuesta
#     ni se avisa antes de que venza un SLA
#     php artisan schedule:run   (cada minuto, por tarea programada del sistema)
#
#  Ademas, para poder adjuntar videos, el php.ini del servidor necesita:
#     upload_max_filesize = 60M
#     post_max_size       = 80M
#
#  Y al desplegar:
#     php artisan migrate --force
#     php artisan storage:link
#     php artisan config:cache
#
# ==============================================================================
